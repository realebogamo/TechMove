@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-4">Contract dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100" asp-controller="Contracts" asp-action="Index">
            <div class="card-body"><div class="text-muted small">All contracts</div><div class="fs-3 fw-semibold">@Model.TotalContracts</div></div>
        </a>
    </div>
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100 border-success" asp-controller="Contracts" asp-action="Index" asp-route-Status="Active">
            <div class="card-body"><div class="text-muted small">Active</div><div class="fs-3 fw-semibold text-success">@Model.Active</div></div>
        </a>
    </div>
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100" asp-controller="Contracts" asp-action="Index" asp-route-Status="Draft">
            <div class="card-body"><div class="text-muted small">Draft</div><div class="fs-3 fw-semibold">@Model.Draft</div></div>
        </a>
    </div>
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100 border-warning" asp-controller="Contracts" asp-action="Index" asp-route-Status="OnHold">
            <div class="card-body"><div class="text-muted small">On Hold</div><div class="fs-3 fw-semibold text-warning">@Model.OnHold</div></div>
        </a>
    </div>
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100 border-danger" asp-controller="Contracts" asp-action="Index" asp-route-Status="Expired">
            <div class="card-body"><div class="text-muted small">Expired</div><div class="fs-3 fw-semibold text-danger">@Model.Expired</div></div>
        </a>
    </div>
    <div class="col-6 col-md">
        <a class="card text-decoration-none h-100" asp-controller="ServiceRequests" asp-action="Index">
            <div class="card-body"><div class="text-muted small">Pending requests</div><div class="fs-3 fw-semibold">@Model.PendingRequests</div></div>
        </a>
    </div>
</div>

<h2 class="h5">Active contracts expiring in the next 60 days</h2>
@if (Model.ExpiringSoon.Count == 0)
{
    <p class="text-muted">No active contracts expire in the next 60 days.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Contract</th><th>Client</th><th>Ends</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model.ExpiringSoon)
            {
                <tr>
                    <td>@c.Title</td>
                    <td>@c.ClientName</td>
                    <td>@c.EndDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end"><a asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}
