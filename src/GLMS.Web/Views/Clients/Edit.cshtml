@model ClientInputDto
@{
    ViewData["Title"] = "Edit client";
    var id = (int)ViewBag.ClientId;
}

<h1 class="h3 mb-3">Edit client</h1>
<form asp-action="Edit" asp-route-id="@id" method="post">
    <partial name="_ClientForm" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Details" asp-route-id="@id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
