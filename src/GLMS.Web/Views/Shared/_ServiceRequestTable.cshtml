@model IReadOnlyList<ServiceRequestDto>
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
@functions {
    // Approve/decline workflow: Pending -> Approved | Declined, Approved -> Completed.
    static (ServiceRequestStatus Target, string Label, string Css)[] Actions(ServiceRequestStatus status) => status switch
    {
        ServiceRequestStatus.Pending => new[] { (ServiceRequestStatus.Approved, "Approve", "btn-outline-success"), (ServiceRequestStatus.Declined, "Decline", "btn-outline-danger") },
        ServiceRequestStatus.Approved => new[] { (ServiceRequestStatus.Completed, "Complete", "btn-outline-dark") },
        _ => Array.Empty<(ServiceRequestStatus, string, string)>()
    };
}

@if (Model.Count == 0)
{
    <p class="text-muted">No service requests.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>#</th><th>Contract</th><th>Description</th><th class="text-end">USD</th><th class="text-end">ZAR</th><th class="text-end">Rate</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@r.ContractId">@r.ContractTitle</a><br /><span class="small text-muted">@r.ClientName</span></td>
                    <td>@r.Description</td>
                    <td class="text-end text-nowrap">@r.CostUsd.Usd()</td>
                    <td class="text-end text-nowrap">@r.CostZar.Zar()</td>
                    <td class="text-end">@r.ExchangeRate.ToString("N4")</td>
                    <td><span class="badge @r.Status.BadgeClass()">@r.Status</span></td>
                    <td class="text-end text-nowrap">
                        @foreach (var (target, label, css) in Actions(r.Status))
                        {
                            <form asp-controller="ServiceRequests" asp-action="ChangeStatus" asp-route-id="@r.Id" method="post" class="d-inline">
                                <input type="hidden" name="status" value="@target" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm @css">@label</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
